DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET="change-me"
PORT=4000
# Production (see deploy/setup-vps.sh): HOST=127.0.0.1 behind Nginx, CORS_ORIGINS=https://naja7school.com,https://www.naja7school.com
# Cycles ouverts au public (les autres affichent « Bientôt disponible ») : OPEN_CYCLES=lycee,college

# Connexion Google : identifiant client OAuth « Application Web » (console.cloud.google.com → Identifiants).
# Origines JavaScript autorisées : https://naja7school.com, https://www.naja7school.com, http://localhost:5173. Le secret client est inutile ici.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Paiement Premium par Stripe Checkout (clé secrète ou clé restreinte avec Checkout Sessions en écriture). Sans clé : bouton inactif (paiement simulé hors production).
# STRIPE_SECRET_KEY=sk_live_...
# Secret de signature du webhook « checkout.session.completed » → https://<site>/api/billing/webhook (Stripe → Développeurs → Webhooks)
# STRIPE_WEBHOOK_SECRET=whsec_...
# Adresse publique du site pour le retour de Stripe (sinon l origine de la requête)
# APP_URL=https://naja7school.com
